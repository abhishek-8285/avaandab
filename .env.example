# Environment configuration
# Copy to .env and adjust values

# Database URL
# SQLite local: file:mvtms.db?cache=shared&mode=rwc
# Turso: libsql://your-database.turso.io?api-token=your-token
DATABASE_URL=file:mvtms.db?cache=shared&mode=rwc&_pragma=journal_mode(WAL)

# Server port
PORT=8080

# Cookie signing secret (use a strong random string in production)
COOKIE_SECRET=dev-secret-32bytes-for-cookie-signing!

# Application environment: development, staging, production
APP_ENV=development

# Application Domain
APP_DOMAIN=avandab.com

# Log level: debug, info, warn, error
LOG_LEVEL=info